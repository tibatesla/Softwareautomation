# Core
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://app_user:app_user_dev_password@localhost:55432/chestone
MIGRATIONS_DATABASE_URL=postgresql://chestone:chestone_dev_password@localhost:55432/chestone
REDIS_URL=redis://localhost:56379

# Auth
JWT_SECRET=replace_with_a_real_random_secret
JWT_EXPIRES_IN=8h

# WhatsApp (Meta Business Cloud API, direct integration)
WHATSAPP_PHONE_NUMBER_ID=replace_with_real_phone_number_id
WHATSAPP_WEBHOOK_SECRET=replace_with_a_real_random_secret
# META_WHATSAPP_ACCESS_TOKEN is NOT set here -- stored in the system_secrets
# table (provider='meta'), resolved fail-closed via resolveActiveSecret().
# See API-ACCOUNTS-SETUP-GUIDE.md.

# Meta Marketing API + Conversions API
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_DATASET_ID=replace_with_real_capi_dataset_id
META_PAGE_ID=replace_with_real_whatsapp_business_page_id

# Meta Content Publishing (auto-post new listings to Facebook/Instagram --
# see API-ACCOUNTS-SETUP-GUIDE.md Section 9). Reuses META_PAGE_ID above.
# Omit META_INSTAGRAM_BUSINESS_ACCOUNT_ID to post to Facebook only.
# META_CONTENT_PUBLISHING_TOKEN is NOT set here -- stored in system_secrets
# (provider='meta'), same as META_WHATSAPP_ACCESS_TOKEN above.
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Google Ads API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_REFRESH_TOKEN is NOT set here -- stored in system_secrets (provider='google').

# TikTok Marketing API
TIKTOK_ADS_ADVERTISER_ID=
# TIKTOK_ADS_ACCESS_TOKEN is NOT set here -- stored in system_secrets (provider='tiktok').

# Cloudinary (property media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI reasoning layer (Groq primary, self-hosted Ollama fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=llama3.2:1b
