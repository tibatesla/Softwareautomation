    "bullmq": "^5.81.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.8",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.0.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.0"
