{
  "name": "chestone-platform",
  "version": "1.0.0",
  "description": "Chestone Properties CRM & Ad Performance Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrate.ts && npm run prisma:sync",
    "prisma:sync": "prisma db pull && prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.18.1",
